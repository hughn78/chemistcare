{
  "name": "chemistcare-offline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:bootstrap": "node scripts/bootstrap-local.mjs",
    "local:dev": "vite --host 0.0.0.0 --port 5173",
    "local:build": "vite build",
    "mac:start": "bash ./scripts/mac-start.command",
    "mac:stop": "bash ./scripts/mac-stop.command",
    "stt:binaries": "node electron/openwhispr/scripts/download-whisper-cpp.js --current && node electron/openwhispr/scripts/download-diarization-binary.js --current",
    "stt:binaries:all": "node electron/openwhispr/scripts/download-whisper-cpp.js && node electron/openwhispr/scripts/download-diarization-binary.js",
    "electron:dev": "concurrently -k \"npm run local:dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run local:build && electron-builder --mac dmg zip --publish never",
    "electron:dist": "npm run local:bootstrap && npm run electron:build",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "electron:build:win": "npm run local:build && electron-builder --win nsis portable --publish never",
    "electron:dist:win": "npm run local:bootstrap && npm run electron:build:win"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@elevenlabs/react": "^0.14.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "fabric": "^6.6.1",
    "ffmpeg-static": "^5.2.0",
    "framer-motion": "^12.34.3",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "onnxruntime-node": "^1.21.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.4.3",
    "unbzip2-stream": "^1.4.3",
    "unzipper": "^0.12.3",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.1",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "au.com.chemistcare.offline",
    "productName": "ChemistCare-Offline",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron/**/*",
      "!electron/openwhispr/resources/**",
      "!electron/resources/**",
      "package.json",
      "THIRD_PARTY_LICENSES.md",
      "OFFLINE_STT.md"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "electron/resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ChemistCare-Offline records consultation audio for on-device transcription. Audio never leaves this computer."
      },
      "artifactName": "ChemistCare-Offline-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "ChemistCare-Offline",
      "artifactName": "ChemistCare-Offline-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ChemistCare-Offline-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ChemistCare-Offline-${version}-Portable-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChemistCare-Offline"
    }
  }
}
